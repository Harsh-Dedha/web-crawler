# Copy to .env and adjust for your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crawler_user
POSTGRES_PASSWORD=crawler_password
POSTGRES_DB=search_engine
# Optional: POSTGRES_DSN=postgresql://crawler_user:crawler_password@localhost:5432/search_engine

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

CRAWLER_WORKERS=6
CRAWLER_MAX_CONCURRENCY=50
CRAWLER_DOMAIN_DELAY=1.0
CRAWLER_REQUEST_TIMEOUT=15
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_PAGES=20
CRAWLER_MAX_LINKS_PER_PAGE=25
CRAWLER_MIN_CONTENT_CHARS=200
CRAWLER_SSL_VERIFY=true
# Comma-separated host allow-list. Leave empty to crawl every discovered host.
CRAWLER_ALLOWED_DOMAINS=en.wikipedia.org
# Wikimedia rejects generic/impersonating agents; use a descriptive agent.
CRAWLER_USER_AGENT=MiniSearchCrawler/1.0 (+https://example.com/bot)

BLOOM_EXPECTED_ELEMENTS=1000000
BLOOM_FALSE_POSITIVE_RATE=0.01
